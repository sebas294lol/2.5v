package com.trayectoriadetiro.doscuatro;

import android.app.Activity;
import android.os.Bundle;
import android.graphics.*;
import android.view.*;
import android.content.Context;
import java.util.Random;

public class MainActivity extends Activity {

    private GameView game;

    @Override
    public void onCreate(Bundle b) {
        super.onCreate(b);

        getWindow().setFlags(
                WindowManager.LayoutParams.FLAG_FULLSCREEN,
                WindowManager.LayoutParams.FLAG_FULLSCREEN
        );

        game = new GameView(this);
        setContentView(game);
    }

    @Override
    protected void onResume() {
        super.onResume();
        if (game != null) game.startLoop();
    }

    @Override
    protected void onPause() {
        if (game != null) game.stopLoop();
        super.onPause();
    }

    static class GameView extends View {

        final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
        final Random rng = new Random();

        long last;
        boolean running;

        int mode = 0;
        int diff = 1;

        float power = 7;
        float curve = 0;
        float height = 50;

        float bx, by;
        float tx, ty;

        float shotT = 1;
        float shotDur = .8f;

        float keeperX, keeperY;
        float keeperTX, keeperTY;
        float dive = 0;

        float playerAnim;
        float goalPulse;

        float ballX, ballY;

        int goals;
        int saves;
        int shots;
        int streak;
        int record;
        int challenge;

        boolean shooting;
        boolean botTurn;

        RectF goal = new RectF();

        GameView(Context c) {
            super(c);

            p.setTypeface(Typeface.create("sans", 0));
            setFocusable(true);
        }

        void startLoop() {

            if (running) return;

            running = true;
            last = System.nanoTime();

            postOnAnimation(loop);
        }

        void stopLoop() {

            running = false;
            removeCallbacks(loop);
        }

        final Runnable loop = new Runnable() {

            @Override
            public void run() {

                if (!running) return;

                long now = System.nanoTime();

                float dt = Math.min(
                        .05f,
                        (now - last) / 1e9f
                );

                last = now;

                update(dt);

                invalidate();

                postOnAnimation(this);
            }
        };

        @Override
        protected void onSizeChanged(
                int w,
                int h,
                int oldw,
                int oldh
        ) {

            resetPositions(w, h);
        }

        void resetPositions(int w, int h) {

            goal.set(
                    w * .73f,
                    h * .27f,
                    w * .94f,
                    h * .70f
            );

            bx = w * .18f;
            by = h * .58f;

            keeperX = goal.centerX();
            keeperY = goal.centerY();

            tx = goal.centerX();
            ty = goal.centerY();
        }

        void update(float dt) {

            goalPulse = Math.max(
                    0,
                    goalPulse - dt * 2.2f
            );

            playerAnim += dt * 5;

            if (
                    mode == 2 &&
                    !shooting &&
                    !botTurn
            ) {

                botTurn = true;

                postDelayed(
                        () -> {

                            if (
                                    mode == 2 &&
                                    !shooting
                            ) {
                                botShoot();
                            }

                            botTurn = false;

                        },
                        420
                );
            }

            if (shooting) {

                shotT += dt / shotDur;

                if (shotT >= 1) {

                    shotT = 1;
                    shooting = false;

                    resolveShot();
                }
            }

            updateKeeper(dt);
        }

        void updateKeeper(float dt) {

            if (mode == 2) return;

            float speed;

            if (diff == 1) {
                speed = 2.0f;
            } else if (diff == 2) {
                speed = 3.0f;
            } else {
                speed = 4.1f;
            }

            float dx = keeperTX - keeperX;
            float dy = keeperTY - keeperY;

            float d = (float)Math.hypot(dx, dy);

            if (d > 2) {

                float q = Math.min(
                        1,
                        speed * dt * 1.7f / d
                );

                keeperX += dx * q;
                keeperY += dy * q;
            }

            keeperX = clamp(
                    keeperX,
                    goal.left + 8,
                    goal.right - 8
            );

            keeperY = clamp(
                    keeperY,
                    goal.top + 8,
                    goal.bottom - 8
            );

            dive = Math.max(
                    0,
                    dive - dt * 2.8f
            );
        }

        void updateBall() {

            float t = Math.max(
                    0,
                    Math.min(1, shotT)
            );

            float s = t * t * (3 - 2 * t);

            float x =
                    bx +
                    (tx - bx) * s;

            float y =
                    by +
                    (ty - by) * s;

            float arch =
                    (float)Math.sin(Math.PI * t) *
                    (height / 50f) *
                    Math.min(
                            150,
                            goal.height()
                    );

            float lateral =
                    (float)Math.sin(Math.PI * t) *
                    curve *
                    2.2f;

            ballX = x + lateral;
            ballY = y - arch;
        }

        void shoot(float x, float y) {

            if (shooting) return;

            tx = clamp(
                    x,
                    goal.left - 30,
                    goal.right + 30
            );

            ty = clamp(
                    y,
                    goal.top - 55,
                    goal.bottom + 55
            );

            shotT = 0;

            shotDur = Math.max(
                    .28f,
                    1.05f - power * .075f
            );

            shooting = true;

            shots++;
        }

        void botShoot() {

            float margin = 12;

            tx =
                    goal.left +
                    margin +
                    rng.nextFloat() *
                    (goal.width() - margin * 2);

            ty =
                    goal.top +
                    margin +
                    rng.nextFloat() *
                    (goal.height() - margin * 2);

            if (diff == 1) {

                power =
                        5 +
                        rng.nextFloat() * 2;

            } else if (diff == 2) {

                power =
                        6 +
                        rng.nextFloat() * 3;

            } else {

                power =
                        8 +
                        rng.nextFloat() * 2;
            }

            curve =
                    (rng.nextFloat() * 2 - 1) *
                    (diff == 1 ? 7 :
                    diff == 2 ? 14 : 22);

            height =
                    20 +
                    rng.nextFloat() * 65;

            shoot(tx, ty);
        }

        boolean insideGoal() {

            return
                    ballX >= goal.left &&
                    ballX <= goal.right &&
                    ballY >= goal.top &&
                    ballY <= goal.bottom;
        }

        boolean saved() {

            return Math.hypot(
                    ballX - keeperX,
                    ballY - keeperY
            ) <
                    30 +
                    (10 - diff) * 4;
        }

        void resolveShot() {

            boolean goal =
                    insideGoal() &&
                    !saved();

            if (goal) {

                goals++;

                streak++;

                record =
                        Math.max(
                                record,
                                streak
                        );

                goalPulse = 1;

                challenge++;

            } else {

                if (insideGoal()) {
                    saves++;
                }

                streak = 0;
            }

            if (
                    mode == 1 &&
                    shots % 10 == 0
            ) {

                challenge = 0;
            }
        }

        float clamp(
                float value,
                float min,
                float max
        ) {

            return Math.max(
                    min,
                    Math.min(max, value)
            );
        }

        @Override
        protected void onDraw(Canvas c) {

            int w = getWidth();
            int h = getHeight();

            p.setStyle(Paint.Style.FILL);

            p.setColor(
                    Color.rgb(24, 125, 62)
            );

            c.drawRect(
                    0,
                    0,
                    w,
                    h,
                    p
            );

            p.setColor(
                    Color.rgb(38, 150, 75)
            );

            c.drawRect(
                    0,
                    h * .12f,
                    w,
                    h,
                    p
            );

            p.setStyle(Paint.Style.STROKE);
            p.setStrokeWidth(4);

            p.setColor(
                    Color.argb(
                            150,
                            255,
                            255,
                            255
                    )
            );

            c.drawRect(
                    w * .04f,
                    h * .12f,
                    w * .69f,
                    h * .88f,
                    p
            );

            c.drawCircle(
                    w * .365f,
                    h * .5f,
                    h * .13f,
                    p
            );

            p.setStyle(Paint.Style.FILL);

            drawGoal(c);
            drawHud(c);

            if (mode == 0) {

                drawMenu(c);

                return;
            }

            if (mode == 2) {

                drawKeeperMode(c);

            } else {

                drawNormal(c);
            }

            if (shooting) {

                updateBall();

                drawTrajectory(c);

                drawBall(
                        c,
                        ballX,
                        ballY
                );

            } else {

                drawBall(
                        c,
                        bx,
                        by
                );
            }

            drawPlayer(c);
        }

        void drawGoal(Canvas c) {

            p.setStyle(Paint.Style.STROKE);
            p.setStrokeWidth(7);
            p.setColor(Color.WHITE);

            c.drawRect(
                    goal,
                    p
            );

            p.setStrokeWidth(2);

            for (int i = 1; i < 5; i++) {

                float x =
                        goal.left +
                        goal.width() * i / 5;

                c.drawLine(
                        x,
                        goal.top,
                        x,
                        goal.bottom,
                        p
                );
            }

            for (int i = 1; i < 4; i++) {

                float y =
                        goal.top +
                        goal.height() * i / 4;

                c.drawLine(
                        goal.left,
                        y,
                        goal.right,
                        y,
                        p
                );
            }

            p.setStyle(Paint.Style.FILL);

            if (goalPulse > 0) {

                p.setColor(
                        Color.argb(
                                (int)(90 * goalPulse),
                                255,
                                255,
                                0
                        )
                );

                c.drawRect(
                        goal,
                        p
                );
            }
        }

        void drawHud(Canvas c) {

            p.setColor(Color.WHITE);
            p.setTextSize(22);
            p.setTypeface(
                    Typeface.DEFAULT_BOLD
            );

            c.drawText(
                    "TRAYECTORIA DE TIROS 2.5",
                    20,
                    30,
                    p
            );

            if (mode > 0) {

                c.drawText(
                        "Goles " + goals +
                        "  Atajadas " + saves +
                        "  Racha " + streak +
                        "  Récord " + record,
                        20,
                        58,
                        p
                );
            }
        }

        void drawMenu(Canvas c) {

            p.setTextAlign(
                    Paint.Align.CENTER
            );

            p.setTextSize(30);
            p.setColor(Color.WHITE);

            c.drawText(
                    "⚽ TRAYECTORIA DE TIROS",
                    getWidth() / 2f,
                    getHeight() * .22f,
                    p
            );

            button(
                    c,
                    "🎯 Normal",
                    .38f
            );

            button(
                    c,
                    "🏆 Retos",
                    .51f
            );

            button(
                    c,
                    "🧤 Modo Portero",
                    .64f
            );

            button(
                    c,
                    "🥅 Penales",
                    .77f
            );

            button(
                    c,
                    "🎯 Tiros Libres",
                    .87f
            );

            p.setTextAlign(
                    Paint.Align.LEFT
            );
        }

        void button(
                Canvas c,
                String text,
                float y
        ) {

            p.setColor(
                    Color.argb(
                            225,
                            15,
                            80,
                            40
                    )
            );

            c.drawRoundRect(
                    getWidth() * .30f,
                    getHeight() * y - 28,
                    getWidth() * .70f,
                    getHeight() * y + 28,
                    16,
                    16,
                    p
            );

            p.setColor(Color.WHITE);
            p.setTextSize(22);

            c.drawText(
                    text,
                    getWidth() / 2f,
                    getHeight() * y + 8,
                    p
            );
        }

        void drawNormal(Canvas c) {

            p.setColor(Color.WHITE);
            p.setTextSize(18);

            c.drawText(
                    "Toca el arco para apuntar • toca la izquierda para disparar",
                    20,
                    getHeight() - 20,
                    p
            );
        }

        void drawKeeperMode(Canvas c) {

            p.setColor(Color.WHITE);
            p.setTextSize(18);

            c.drawText(
                    "PORTERO: mueve al portero tocando el arco • dificultad " + diff,
                    20,
                    getHeight() - 45,
                    p
            );

            c.drawText(
                    "10 tiros • objetivo: detenerlos",
                    20,
                    getHeight() - 20,
                    p
            );

            drawKeeper(c);
        }

        void drawTrajectory(Canvas c) {

            p.setStyle(
                    Paint.Style.STROKE
            );

            p.setStrokeWidth(4);

            p.setColor(Color.WHITE);

            Path path = new Path();

            path.moveTo(
                    bx,
                    by
            );

            for (int i = 1; i <= 24; i++) {

                float t =
                        i / 24f;

                float s =
                        t * t *
                        (3 - 2 * t);

                float x =
                        bx +
                        (tx - bx) * s +
                        (float)Math.sin(
                                Math.PI * t
                        ) *
                        curve *
                        2.2f;

                float y =
                        by +
                        (ty - by) * s -
                        (float)Math.sin(
                                Math.PI * t
                        ) *
                        (height / 50f) *
                        Math.min(
                                150,
                                goal.height()
                        );

                path.lineTo(
                        x,
                        y
                );
            }

            c.drawPath(
                    path,
                    p
            );

            p.setStyle(
                    Paint.Style.FILL
            );
        }

        void drawBall(
                Canvas c,
                float x,
                float y
        ) {

            p.setColor(Color.WHITE);

            c.drawCircle(
                    x,
                    y,
                    13,
                    p
            );

            p.setColor(Color.DKGRAY);

            c.drawCircle(
                    x - 4,
                    y - 3,
                    3,
                    p
            );

            c.drawCircle(
                    x + 4,
                    y + 3,
                    3,
                    p
            );
        }

        void drawPlayer(Canvas c) {

            float x = bx;

            float y =
                    by +
                    30 +
                    (float)Math.sin(
                            playerAnim
                    ) * 2;

            p.setColor(Color.WHITE);

            c.drawCircle(
                    x,
                    y - 35,
                    11,
                    p
            );

            c.drawRect(
                    x - 9,
                    y - 23,
                    x + 9,
                    y + 10,
                    p
            );

            p.setColor(Color.BLACK);

            c.drawRect(
                    x - 9,
                    y + 10,
                    x - 2,
                    y + 28,
                    p
            );

            c.drawRect(
                    x + 2,
                    y + 10,
                    x + 9,
                    y + 28,
                    p
            );
        }

        void drawKeeper(Canvas c) {

            p.setColor(Color.YELLOW);

            c.drawCircle(
                    keeperX,
                    keeperY - 18,
                    9,
                    p
            );

            c.drawRect(
                    keeperX - 9,
                    keeperY - 8,
                    keeperX + 9,
                    keeperY + 16,
                    p
            );

            p.setStyle(
                    Paint.Style.STROKE
            );

            p.setStrokeWidth(5);

            c.drawLine(
                    keeperX - 9,
                    keeperY - 2,
                    keeperX - 25 - dive * 8,
                    keeperY + 8,
                    p
            );

            c.drawLine(
                    keeperX + 9,
                    keeperY - 2,
                    keeperX + 25 + dive * 8,
                    keeperY + 8,
                    p
            );

            p.setStyle(
                    Paint.Style.FILL
            );
        }

        @Override
        public boolean onTouchEvent(
                MotionEvent e
        ) {

            if (
                    e.getAction() !=
                    MotionEvent.ACTION_DOWN
            ) {
                return true;
            }

            float x = e.getX();
            float y = e.getY();
            float h = getHeight();

            if (mode == 0) {

                if (
                        y > h * .33f &&
                        y < h * .45f
                ) {

                    mode = 3;

                } else if (
                        y > h * .46f &&
                        y < h * .57f
                ) {

                    mode = 1;

                } else if (
                        y > h * .59f &&
                        y < h * .70f
                ) {

                    mode = 2;

                } else if (
                        y > h * .72f &&
                        y < h * .83f
                ) {

                    mode = 3;
                }

                startLoop();

                return true;
            }

            if (mode == 2) {

                if (
                        x > goal.left - 35
                ) {

                    keeperTX =
                            clamp(
                                    x,
                                    goal.left + 8,
                                    goal.right - 8
                            );

                    keeperTY =
                            clamp(
                                    y,
                                    goal.top + 8,
                                    goal.bottom - 8
                            );

                    dive = 1;
                }

            } else {

                if (
                        x > getWidth() * .55f
                ) {

                    shoot(
                            x,
                            y
                    );

                } else if (!shooting) {

                    shoot(
                            goal.centerX(),
                            goal.centerY()
                    );
                }
            }

            return true;
        }
    }
}
